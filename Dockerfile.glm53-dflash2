FROM vllm/vllm-openai:glm53-flash-arm64-cu130

ARG VLLM_ROOT=/usr/local/lib/python3.12/dist-packages/vllm
ARG FLASHINFER_VERSION=0.6.18.dev20260819
ARG BUILD_JOBS=16
ENV MAX_JOBS=${BUILD_JOBS}

COPY mods/glm53-dflash2 /opt/spark-vllm/glm53-dflash2

# Reproduce the reference image's SM121 v1 -> v8 patch chain in order.
RUN python3 /opt/spark-vllm/glm53-dflash2/patch_nope_mla.py

RUN pip install -q --pre \
        "flashinfer-python==${FLASHINFER_VERSION}" \
        "flashinfer-cubin==${FLASHINFER_VERSION}" \
        --extra-index-url https://flashinfer.ai/whl/nightly/ \
    && pip uninstall -q -y flashinfer-jit-cache \
    && python3 -c "import flashinfer; assert flashinfer.__version__.startswith('${FLASHINFER_VERSION}')"

# FlashInfer's nightly resolver changes both packages. Restore the versions
# qualified by the reference for the Spark fabric and CuTeDSL warmup.
RUN pip install -q nvidia-nccl-cu13==2.30.7 \
    && pip show nvidia-nccl-cu13 | grep -q "Version: 2.30.7"
RUN pip install -q nvidia-cutlass-dsl==4.6.2 \
    && pip show nvidia-cutlass-dsl | grep -q "Version: 4.6.2"

RUN python3 /opt/spark-vllm/glm53-dflash2/patch_pdl.py \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_v7.py \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_v8_fp8.py

# Add the complete DFlash2 runtime overlay and GLM target-side glue.
RUN install -m 0644 \
        /opt/spark-vllm/glm53-dflash2/qwen3_dflash2.py \
        "$VLLM_ROOT/model_executor/models/qwen3_dflash2.py" \
    && install -d "$VLLM_ROOT/v1/worker/gpu/spec_decode/dflash2" \
    && cp -a /opt/spark-vllm/glm53-dflash2/dflash2/. \
        "$VLLM_ROOT/v1/worker/gpu/spec_decode/dflash2/" \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_registry_and_select.py \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_glm_aux_capture.py \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_kv_page_lcm2.py \
    && python3 /opt/spark-vllm/glm53-dflash2/patch_glm5_drafter_group.py \
    && python3 /opt/spark-vllm/glm53-dflash2/sim_glm5_drafter.py

# The published v11 image still needs this later SM121 long-context fix.
RUN python3 /opt/spark-vllm/glm53-dflash2/patch_sm121_topk.py \
        "$VLLM_ROOT/model_executor/layers/sparse_attn_indexer_kpool.py" \
    && install -d /opt/spark-vllm/glm53 \
    && install -m 0644 \
        /opt/spark-vllm/glm53-dflash2/chat_template_mm.jinja \
        /opt/spark-vllm/glm53/chat_template_mm.jinja \
    && python3 -c 'from vllm.model_executor.models.registry import ModelRegistry; assert "DFlash2DraftModel" in ModelRegistry.get_supported_archs()' \
    && find "$VLLM_ROOT" -name __pycache__ -type d -exec rm -rf {} +
